---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site';
import formattedDate from '../utils/formattedDate';
import publishDateToMachineFriendlyDate from '../utils/publishDateToMachineFriendlyDate';
import Spacer from '../components/Spacer'

const title = `${site.name}'s Blog`
const description = `${site.name}'s blog with articles on webdev, indiehacking and web3.`
const tagline = "Posts on webdev, indiehacking and web3"

const allPosts = await Astro.glob('../data/posts/*.md')
const sortedPosts = allPosts.sort((a, b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date));
---
<BaseLayout title={title} description={description} canonicalURL={Astro.url.href} excludeNewsletter tagline={tagline}>
    <h1 class="text-3xl">Blog</h1>
    <p class="mb-6">All the blog posts and articles I've written.</p>
    
    <section>
    
    {sortedPosts.map(post => (
      <div class="flex flex-row items-center justify-between mb-4">
        <a href={`/${post.frontmatter.slug}`}>
          <h3 class="font-semibold text-lg">{post.frontmatter.title}</h3>
        </a>
      
        <div class="flex flex-col items-end justify-center">
          <time class="text-xs mb-2 block" dateTime={publishDateToMachineFriendlyDate(post.frontmatter.date)}>{formattedDate(new Date(post.frontmatter.date))}</time>
        </div>

      </div>
    ))}
    </section>
</BaseLayout>

